    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@react-router/dev": "8.4.0",
    "@tailwindcss/vite": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^6.0.2",
    "vite": "^8"
  },
  "pnpm": {
    "overrides": {
      "baseline-browser-mapping@2.10.32": "2.11.0",
